{
  // Cloudflare Workers med statiske filer. Serverer alt i public/ uden kode.
  // Alternativ: Cloudflare Pages med build output directory = public og tom build command.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tjekditfly",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
